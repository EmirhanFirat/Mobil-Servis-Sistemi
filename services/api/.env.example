# Kopyala: Copy-Item .env.example .env   (.env commitlenmez)
# Değerler yalnızca yerel geliştirme içindir; gerçek anahtar veya parola yazma.
TALEPAKIS_ENVIRONMENT=development
TALEPAKIS_DATABASE_URL=postgresql+psycopg://talepakis:talepakis@127.0.0.1:5432/talepakis

# Oturum belirteçlerini imzalar. Üretimde en az 32 karakterlik rastgele bir değer şarttır:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Boş bırakılırsa yalnızca geliştirme için güvensiz bir varsayılan kullanılır.
# TALEPAKIS_SECRET_KEY=

# Yönetici panelinin (tarayıcı) adresleri, JSON dizisi olarak.
# TALEPAKIS_CORS_ORIGINS=["http://localhost:5173"]
