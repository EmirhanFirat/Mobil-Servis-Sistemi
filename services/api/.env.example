# Kopyala: Copy-Item .env.example .env   (.env commitlenmez)
# Değerler yalnızca yerel geliştirme içindir; gerçek anahtar veya parola yazma.
TALEPAKIS_ENVIRONMENT=development
TALEPAKIS_DATABASE_URL=postgresql+psycopg://talepakis:talepakis@127.0.0.1:5432/talepakis

# Oturum belirteçlerini imzalar. Üretimde en az 32 karakterlik rastgele bir değer şarttır:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Boş bırakılırsa yalnızca geliştirme için güvensiz bir varsayılan kullanılır.
# TALEPAKIS_SECRET_KEY=

# Ücretli model çağrıları VARSAYILAN OLARAK KAPALIDIR. Gerçek Jev çağrısı yalnızca bütçe
# onayından sonra açılır. Anahtarı depoya, sohbete veya bu dosyaya yazma; yalnızca o oturumun
# ortam değişkeni olarak ver (PowerShell: $env:TALEPAKIS_JEV_API_KEY = "...").
# TALEPAKIS_PAID_MODEL_CALLS_ENABLED=false
# TALEPAKIS_JEV_API_KEY=
# Ekonomik LLM (Anthropic). Standart ANTHROPIC_API_KEY okunmaz; yalnızca bu proje anahtarı:
# TALEPAKIS_ANTHROPIC_API_KEY=

# Yönetici panelinin (tarayıcı) adresleri, JSON dizisi olarak.
# TALEPAKIS_CORS_ORIGINS=["http://localhost:5173"]

# Karar motoru: talep açılırken kaydedilen karar işinin stratejisi. Yalnızca ücretsiz stratejiler:
# rule_based (varsayılan), mock_jev, mock_llm, mock_hybrid; off = iş kaydetme. Worker: python -m app.worker
# TALEPAKIS_DECISION_STRATEGY=rule_based
